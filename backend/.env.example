SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./fraud_detection.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# "development" allows the placeholder SECRET_KEY / ADMIN_PASSWORD above.
# Never set it on a public deploy: without it the backend refuses to start
# with placeholder or weak secrets.
APP_ENV=development

# Email to account holders when an analyst confirms their account as fraud.
# Optional: without SMTP_HOST, confirmations still work and each email is
# logged as failed ("not configured") so it can be retried once this is set.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls        # starttls (port 587) | ssl (port 465) | none (local test servers only)
# EMAIL_FROM=fraud-alerts@your-domain.com
# EMAIL_FROM_NAME=Fraud Monitoring Team
# EMAIL_SUPPORT_CONTACT=        # shown to account holders, e.g. a support URL or phone number
